server:
  port: 8080

spring:
  application:
    name: citywalk-backend

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/citywalk?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: your_mysql_username
    password: your_mysql_password

  data:
    redis:
      host: localhost
      port: 6379
      database: 0
      timeout: 5000ms

  ai:
    openai:
      api-key: your_deepseek_api_key
      base-url: https://api.deepseek.com
      chat:
        options:
          model: deepseek-chat
          temperature: 0.7

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto

amap:
  key: your_amap_key
  base-url: https://restapi.amap.com

knife4j:
  enable: true
  setting:
    language: zh_cn